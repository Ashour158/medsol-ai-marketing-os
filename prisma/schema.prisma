generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum CampaignStatus {
  IDEA
  ASSESSMENT
  PROPOSED
  APPROVAL_PENDING
  APPROVED
  PLANNING
  IN_PRODUCTION
  REVIEW
  READY
  LIVE
  OPTIMIZING
  COMPLETED
  ANALYZED
  LEARNED
  ARCHIVED
}
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  APPROVED_WITH_CONDITIONS
}
enum RiskLevel {
  R0
  R1
  R2
  R3
  R4
}
enum AgentStatus {
  ACTIVE
  PAUSED
  RETIRED
}
enum AuditActorType {
  HUMAN
  AGENT
  SYSTEM
}
model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  authSessions AuthSession[]
  modelBudgets ModelBudget[]
  modelUsage ModelUsage[]
  agents Agent[]
  agentExecutions AgentExecution[]
  objectives MarketingObjective[]
  products MarketingProduct[]
  campaigns Campaign[]
  approvals Approval[]
  auditEvents AuditEvent[]
  commandReceipts CommandReceipt[]
  outboxEvents OutboxEvent[]
  inboxEvents InboxEvent[]
  workflows WorkflowExecution[]
  workflowSteps WorkflowStepExecution[]
}
model User {
  id String @id @default(cuid())
  organizationId String
  email String
  name String
  role String
  oidcSubject String?
  disabledAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,email])
  @@unique([organizationId,oidcSubject])
  @@index([organizationId])
}
model Agent {
  id String @id
  organizationId String
  name String
  status AgentStatus @default(ACTIVE)
  version Int @default(1)
  capabilities Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  executions AgentExecution[]
  @@index([organizationId,status])
}
model AgentExecution {
  id String @id @default(cuid())
  organizationId String
  agentId String
  correlationId String
  causationId String?
  input Json
  decision Json?
  status String
  startedAt DateTime @default(now())
  completedAt DateTime?
  agent Agent @relation(fields:[agentId],references:[id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@index([organizationId,correlationId])
}
model MarketingObjective {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  metric Json?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaigns Campaign[]
  @@index([organizationId,status])
}
model MarketingProduct {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  vendor String?
  lifecycle String @default("ACTIVE")
  marketingProfile Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaigns Campaign[]
  @@unique([organizationId,code])
}
model Campaign {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  objectiveId String
  productId String?
  status CampaignStatus @default(IDEA)
  riskLevel RiskLevel @default(R1)
  version Int @default(1)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  objective MarketingObjective @relation(fields:[objectiveId],references:[id],onDelete:Restrict)
  product MarketingProduct? @relation(fields:[productId],references:[id],onDelete:Restrict)
  @@unique([organizationId,code])
  @@index([organizationId,status])
}
model Approval {
  id String @id @default(cuid())
  organizationId String
  objectType String
  objectId String
  requiredAuthority String
  riskLevel RiskLevel
  decision ApprovalDecision @default(PENDING)
  decidedBy String?
  rationale String?
  workflowExecutionId String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  workflow WorkflowExecution? @relation(fields:[workflowExecutionId],references:[id],onDelete:Restrict)
  @@index([organizationId,objectType,objectId])
  @@index([organizationId,decision])
  @@index([organizationId,workflowExecutionId])
}
model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  actorType AuditActorType
  actorId String
  action String
  objectType String
  objectId String
  before Json?
  after Json?
  correlationId String
  causationId String?
  occurredAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@index([organizationId,occurredAt])
  @@index([organizationId,objectType,objectId])
}
model CommandReceipt {
  id String @id @default(cuid())
  organizationId String
  commandId String
  commandType String
  correlationId String
  status String
  response Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,commandId])
}
model InboxEvent {
  id String @id @default(cuid())
  organizationId String
  eventId String
  consumerName String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  status String @default("RECEIVED")
  lastError String?
  attempts Int @default(0)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,consumerName,eventId])
  @@index([organizationId,status,receivedAt])
}

model OutboxEvent {
  id String @id @default(cuid())
  organizationId String
  eventId String
  eventType String
  aggregateType String
  aggregateId String
  version Int @default(1)
  payload Json
  correlationId String
  causationId String?
  occurredAt DateTime @default(now())
  publishingAt DateTime?
  publishedAt DateTime?
  nextAttemptAt DateTime?
  deadLetteredAt DateTime?
  attempts Int @default(0)
  lastError String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,eventId])
  @@index([organizationId,publishedAt,publishingAt,occurredAt])
}

enum WorkflowExecutionStatus {
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  BLOCKED
  CANCELLED
}
model WorkflowExecution {
  id String @id @default(cuid())
  organizationId String
  workflowType String
  status WorkflowExecutionStatus @default(RUNNING)
  currentStep String
  correlationId String
  causationId String?
  input Json
  output Json?
  error Json?
  version Int @default(1)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  leaseOwner String?
  leaseExpiresAt DateTime?
  leaseGeneration Int @default(0)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  steps WorkflowStepExecution[]
  approvals Approval[]
  @@index([organizationId,status])
  @@index([organizationId,correlationId])
}
model WorkflowStepExecution {
  id String @id @default(cuid())
  workflowExecutionId String
  organizationId String
  stepKey String
  status String
  attempt Int @default(1)
  input Json?
  output Json?
  error Json?
  startedAt DateTime @default(now())
  completedAt DateTime?
  workflow WorkflowExecution @relation(fields:[workflowExecutionId],references:[id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([workflowExecutionId,stepKey])
  @@index([organizationId,status])
}
model AuthSession {
  id String @id
  organizationId String
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId,userId,revokedAt,expiresAt])
}

model ModelBudget {
  organizationId String @id
  limitMicros BigInt
  reservedMicros BigInt @default(0)
  spentMicros BigInt @default(0)
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model ModelUsage {
  id String @id @default(cuid())
  organizationId String
  requestId String
  agentId String
  reservedMicros BigInt
  actualMicros BigInt?
  providerRequestId String?
  evidenceReference String?
  status String
  model String?
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId,requestId])
  @@index([organizationId,status,createdAt])
}
