  oauthAuthorizationAttempts OAuthAuthorizationAttempt[]
  providerCredential ProviderCredential?
  providerAccountObservations ProviderAccountObservation[]
  providerWebhookObservations ProviderWebhookObservation[]
  publicationAttempts PublicationAttempt[]
  @@index([organizationId,brandId,status])
}

/** R2B actual-byte readback proof linked to an immutable creative revision.
 * Only server-owned verifier may create; no public arbitrary SHA assertion API.
 */
model VerifiedMediaEvidence {
  id String @id @default(cuid())
  organizationId String
  creativeAssetRevisionId String
  sourceRef String
  objectVersion String
  sha256Digest String
  sizeBytes Int
  detectedMime String
