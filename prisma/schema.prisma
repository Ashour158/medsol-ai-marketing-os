generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum CampaignStatus {
  IDEA
  ASSESSMENT
  PROPOSED
  APPROVAL_PENDING
  APPROVED
  PLANNING
  IN_PRODUCTION
  REVIEW
  READY
  LIVE
  OPTIMIZING
  COMPLETED
  ANALYZED
  LEARNED
  ARCHIVED
}
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  APPROVED_WITH_CONDITIONS
}
enum RiskLevel {
  R0
  R1
  R2
  R3
  R4
}
enum AgentStatus {
  ACTIVE
  PAUSED
  RETIRED
}
enum AuditActorType {
  HUMAN
  AGENT
  SYSTEM
}
model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  authSessions AuthSession[]
  modelBudgets ModelBudget[]
  modelUsage ModelUsage[]
  agents Agent[]
  blueprintDeployments BlueprintDeployment[]
  agentManifestRevisions AgentManifestRevision[]
  agentExecutions AgentExecution[]
  objectives MarketingObjective[]
  products MarketingProduct[]
  campaigns Campaign[]
  approvals Approval[]
  auditEvents AuditEvent[]
  commandReceipts CommandReceipt[]
  outboxEvents OutboxEvent[]
  inboxEvents InboxEvent[]
  workflows WorkflowExecution[]
  workflowSteps WorkflowStepExecution[]
  learningSignals LearningSignal[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  knowledgeRelations KnowledgeRelation[]
  agentKnowledgeMemories AgentKnowledgeMemory[]
  skillProposals AgentSkillProposal[]
  brainRuns BrainRun[]
  brainRunSteps BrainRunStep[]
  brandMasterRevisions BrandMasterRevision[]
  marketingMetricObservations MarketingMetricObservation[]
  incidentResponses IncidentResponse[]
  tenantRoles TenantRoleDefinition[]
  creativeAssets CreativeAsset[]
  creativeAssetRevisions CreativeAssetRevision[]
  campaignPublications CampaignPublication[]
  syntheticAudienceContacts MarketingSyntheticContact[]
  syntheticConsentEvents MarketingSyntheticConsent[]
  emailSimulations MarketingEmailSimulation[]
  publicationAttempts PublicationAttempt[]
  integrationConnections IntegrationConnection[]
  governedToolRegistrations GovernedToolRegistration[]
  verifiedMediaEvidence VerifiedMediaEvidence[]
  oauthAuthorizationAttempts OAuthAuthorizationAttempt[]
  providerCredentials ProviderCredential[]
  providerAccountObservations ProviderAccountObservation[]
  providerWebhookObservations ProviderWebhookObservation[]
  brands Brand[]
  clientAgencyGrants AgencyGrant[] @relation("AgencyClientGrants")
  delegatedAgencyGrants AgencyGrant[] @relation("AgencyDelegateGrants")
}
model User {
  id String @id @default(cuid())
  organizationId String
  email String
  name String
  role String
  oidcSubject String?
  tenantRoleDefinitionId String?
  tenantRole TenantRoleDefinition? @relation(fields:[organizationId,tenantRoleDefinitionId],references:[organizationId,id],onDelete:Restrict)
  authSessions AuthSession[]
  disabledAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,id])
  @@unique([organizationId,email])
  @@unique([organizationId,oidcSubject])
  @@index([organizationId])
  @@index([organizationId,tenantRoleDefinitionId])
}
model Agent {
  id String
  organizationId String
  name String
  status AgentStatus @default(ACTIVE)
  version Int @default(1)
  capabilities Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  executions AgentExecution[]
  manifestRevisions AgentManifestRevision[]
  @@id([organizationId,id])
  @@index([organizationId,status])
}
model AgentExecution {
  id String @id @default(cuid())
  organizationId String
  agentId String
  correlationId String
  causationId String?
  input Json
  decision Json?
  status String
  startedAt DateTime @default(now())
  completedAt DateTime?
  agent Agent @relation(fields:[organizationId,agentId],references:[organizationId,id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@index([organizationId,correlationId])
}
model MarketingObjective {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  metric Json?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaigns Campaign[]
  @@unique([organizationId,id])
  @@index([organizationId,status])
}
model MarketingProduct {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  vendor String?
  lifecycle String @default("ACTIVE")
  marketingProfile Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaigns Campaign[]
  @@unique([organizationId,id])
  @@unique([organizationId,code])
}
model Campaign {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  brandId String?
  objectiveId String
  productId String?
  status CampaignStatus @default(IDEA)
  riskLevel RiskLevel @default(R1)
  version Int @default(1)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  objective MarketingObjective @relation(fields:[organizationId,objectiveId],references:[organizationId,id],onDelete:Restrict)
  product MarketingProduct? @relation(fields:[organizationId,productId],references:[organizationId,id],onDelete:Restrict)
  brand Brand? @relation(fields:[organizationId,brandId],references:[organizationId,id],onDelete:Restrict)
  publications CampaignPublication[]
  emailSimulations MarketingEmailSimulation[]
  @@unique([organizationId,code])
  @@unique([organizationId,id])
  @@index([organizationId,status])
  @@index([organizationId,brandId])
  metricObservations MarketingMetricObservation[]
}
model Approval {
  id String @id @default(cuid())
  organizationId String
  objectType String
  objectId String
  requiredAuthority String
  riskLevel RiskLevel
  decision ApprovalDecision @default(PENDING)
  decidedBy String?
  rationale String?
  workflowExecutionId String?
  creativeAssetRevisionId String?
  requestedBy String?
  scopeDigest String?
  scope Json?
  scopeExpiresAt DateTime?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  workflow WorkflowExecution? @relation(fields:[organizationId,workflowExecutionId],references:[organizationId,id],onDelete:Restrict)
  creativeAssetRevision CreativeAssetRevision? @relation(fields:[organizationId,creativeAssetRevisionId],references:[organizationId,id],onDelete:Restrict)
  publications CampaignPublication[]
  @@unique([organizationId,id])
  @@index([organizationId,objectType,objectId])
  @@index([organizationId,decision])
  @@index([organizationId,workflowExecutionId])
  @@index([organizationId,creativeAssetRevisionId])
}
model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  actorType AuditActorType
  actorId String
  action String
  objectType String
  objectId String
  before Json?
  after Json?
  correlationId String
  causationId String?
  occurredAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@index([organizationId,occurredAt])
  @@index([organizationId,objectType,objectId])
}
model CommandReceipt {
  id String @id @default(cuid())
  organizationId String
  commandId String
  commandType String
  correlationId String
  status String
  response Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,commandId])
}
model InboxEvent {
  id String @id @default(cuid())
  organizationId String
  eventId String
  consumerName String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  status String @default("RECEIVED")
  lastError String?
  attempts Int @default(0)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,consumerName,eventId])
  @@index([organizationId,status,receivedAt])
}

model OutboxEvent {
  id String @id @default(cuid())
  organizationId String
  eventId String
  eventType String
  aggregateType String
  aggregateId String
  version Int @default(1)
  payload Json
  correlationId String
  causationId String?
  occurredAt DateTime @default(now())
  publishingAt DateTime?
  publishedAt DateTime?
  nextAttemptAt DateTime?
  deadLetteredAt DateTime?
  attempts Int @default(0)
  lastError String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,eventId])
  @@index([organizationId,publishedAt,publishingAt,occurredAt], map:"OutboxEvent_organizationId_publishedAt_publishingAt_occurredAt_")
  @@index([organizationId,publishedAt,occurredAt])
  @@index([publishedAt,deadLetteredAt,nextAttemptAt,occurredAt], map:"OutboxEvent_delivery_schedule_idx")
}

enum WorkflowExecutionStatus {
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  BLOCKED
  CANCELLED
}
model WorkflowExecution {
  id String @id @default(cuid())
  organizationId String
  workflowType String
  status WorkflowExecutionStatus @default(RUNNING)
  currentStep String
  correlationId String
  causationId String?
  input Json
  output Json?
  error Json?
  version Int @default(1)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  leaseOwner String?
  leaseExpiresAt DateTime?
  leaseGeneration Int @default(0)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  steps WorkflowStepExecution[]
  approvals Approval[]
  @@unique([organizationId,id])
  @@index([organizationId,status])
  @@index([organizationId,correlationId])
  @@index([status,leaseExpiresAt])
}
model WorkflowStepExecution {
  id String @id @default(cuid())
  workflowExecutionId String
  organizationId String
  stepKey String
  status String
  attempt Int @default(1)
  input Json?
  output Json?
  error Json?
  startedAt DateTime @default(now())
  completedAt DateTime?
  workflow WorkflowExecution @relation(fields:[organizationId,workflowExecutionId],references:[organizationId,id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([workflowExecutionId,stepKey])
  @@index([organizationId,status])
}
model AuthSession {
  id String @id
  organizationId String
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields:[organizationId,userId],references:[organizationId,id],onDelete:Restrict)
  @@index([organizationId,userId,revokedAt,expiresAt])
}

model ModelBudget {
  organizationId String @id
  limitMicros BigInt
  reservedMicros BigInt @default(0)
  spentMicros BigInt @default(0)
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model ModelUsage {
  id String @id @default(cuid())
  organizationId String
  requestId String
  agentId String
  reservedMicros BigInt
  actualMicros BigInt? // Usage-price estimate used for policy budgeting, not independently billed cost
  billingStatus String @default("UNVERIFIED")
  verifiedBilledMicros BigInt?
  billedEvidenceReference String?
  billedVerifiedAt DateTime?
  providerRequestId String?
  evidenceReference String?
  status String
  model String?
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId,requestId])
  @@index([organizationId,status,createdAt])
}

model LearningSignal {
  id String @id @default(cuid())
  organizationId String
  fingerprint String
  topic String
  sector String
  sourceUrl String
  sourceTitle String
  observedAt DateTime
  sourcePublishedAt DateTime?
  evidence Json
  knowledgeDocumentId String?
  knowledgeDocument KnowledgeDocument? @relation(fields:[organizationId,knowledgeDocumentId],references:[organizationId,id],onDelete:Restrict)
  status String @default("QUARANTINED")
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,fingerprint])
  @@unique([organizationId,knowledgeDocumentId])
  @@index([organizationId,sector,status,observedAt])
}
model AgentSkillProposal {
  id String @id @default(cuid())
  organizationId String
  agentId String
  skillKey String
  version Int @default(1)
  rationale String
  evidenceSignalId String
  evaluation Json?
  status String @default("PROPOSED")
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,agentId,skillKey,version], map:"AgentSkillProposal_org_agent_skill_version_key")
  @@index([organizationId,status,createdAt], map:"AgentSkillProposal_org_status_created_idx")
}

model BrainRun {
  id String @id @default(cuid())
  organizationId String
  commandKey String
  correlationId String
  input Json
  status String @default("PENDING")
  currentAgentId String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  steps BrainRunStep[]
  @@unique([organizationId,id])
  @@unique([organizationId,commandKey])
  @@index([organizationId,status,createdAt])
}
model BrainRunStep {
  id String @id @default(cuid())
  organizationId String
  runId String
  agentId String
  stage String
  ordinal Int
  status String @default("PENDING")
  executionId String?
  error String?
  startedAt DateTime?
  completedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  run BrainRun @relation(fields:[organizationId,runId],references:[organizationId,id],onDelete:Restrict)
  @@unique([runId,agentId])
  @@unique([runId,ordinal])
  @@index([organizationId,runId,status])
}

model BrandMasterRevision {
  id String @id @default(cuid())
  organizationId String
  version Int
  status String @default("DRAFT")
  sourceReference String
  rules Json
  proposedBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,version])
  @@index([organizationId,status,version])
}

model MarketingMetricObservation {
  id String @id @default(cuid())
  organizationId String
  campaignId String
  sourceSystem String
  sourceRecordId String
  metricKey String
  value BigInt
  observedAt DateTime
  sourceReference String
  status String @default("QUARANTINED")
  submittedBy String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaign Campaign @relation(fields:[organizationId,campaignId],references:[organizationId,id],onDelete:Restrict)
  @@unique([organizationId,sourceSystem,sourceRecordId,metricKey], map:"MarketingMetricObservation_organizationId_sourceSystem_sourceRe")
  @@index([organizationId,campaignId,status,observedAt], map:"MarketingMetricObservation_organizationId_campaignId_status_obs")
}

/**
 * Operational response to an incident, NOT a second source of BrainRun or Outbox status.
 * A new occurrence resets acknowledgement/escalation while preserving source identity.
 */
model IncidentResponse {
  id String @id @default(cuid())
  organizationId String
  kind String
  sourceId String
  occurrenceAt DateTime
  acknowledgedAt DateTime?
  acknowledgedBy String?
  acknowledgedReason String?
  lastNotifiedLevel Int @default(-1)
  nextEscalationAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,kind,sourceId])
  @@index([organizationId,kind,acknowledgedAt])
}

/** Infrastructure heartbeat only: no user / tenant data, no task ownership. */
model MarketingWorkerHeartbeat {
  id String @id
  workerType String
  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  status String @default("ACTIVE")
  lastTickAt DateTime?
  lastTickStatus String?
  @@index([workerType,lastSeenAt])
}

/**
 * R1 authoritative tenant-owned brand identity. BrandMasterRevision remains the
 * approved rules authority until its brand-scoped migration is accepted.
 */
model Brand {
  id String @id @default(cuid())
  organizationId String
  slug String
  name String
  status String @default("ACTIVE")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  agencyGrants AgencyGrant[]
  creativeAssets CreativeAsset[]
  campaigns Campaign[]
  integrationConnections IntegrationConnection[]
  syntheticAudienceContacts MarketingSyntheticContact[]
  emailSimulations MarketingEmailSimulation[]
  @@unique([organizationId,slug])
  @@unique([organizationId,id])
  @@index([organizationId,status])
}

/**
 * Revocable agency-to-client scoped grant. This row alone DOES NOT authorize an
 * agency user; human identity, role and brand access must also be checked.
 * No external effect or unrestricted client tenant access is derived from it.
 */
model AgencyGrant {
  id String @id @default(cuid())
  clientOrganizationId String
  agencyOrganizationId String
  brandId String
  actions Json
  status String @default("ACTIVE")
  expiresAt DateTime
  createdBy String
  revokedBy String?
  revokedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientOrganization Organization @relation("AgencyClientGrants",fields:[clientOrganizationId],references:[id],onDelete:Restrict)
  agencyOrganization Organization @relation("AgencyDelegateGrants",fields:[agencyOrganizationId],references:[id],onDelete:Restrict)
  brand Brand @relation(fields:[clientOrganizationId,brandId],references:[organizationId,id],onDelete:Restrict)
  @@unique([clientOrganizationId,agencyOrganizationId,brandId],map:"AgencyGrant_scope_key")
  @@index([clientOrganizationId,status,expiresAt])
  @@index([agencyOrganizationId,status,expiresAt])
}

/**
 * Restrictive tenant-owned permission profile layered on existing User.role.
 * Its permissions can never widen the built-in role's authority. This is not
 * a duplicate identity/membership store. SQL migration enforces FORCE RLS.
 */
model TenantRoleDefinition {
  id String @id @default(cuid())
  organizationId String
  key String
  name String
  permissions Json
  status String @default("ACTIVE")
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  users User[]
  @@unique([organizationId,key])
  @@unique([organizationId,id])
  @@index([organizationId,status])
}

/**
 * R1C authoritative DAM asset identity and immutable source revision chain.
 * The binary/source is NOT uploaded or verified by these metadata records:
 * sourceRef must be an internally verified object-store reference before
 * customer production. No external publishing authority exists here.
 */
model CreativeAsset {
  id String @id @default(cuid())
  organizationId String
  brandId String
  title String
  status String @default("ACTIVE")
  version Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  brand Brand @relation(fields:[organizationId,brandId],references:[organizationId,id],onDelete:Restrict)
  revisions CreativeAssetRevision[]
  @@unique([organizationId,id])
  @@index([organizationId,brandId,status])
}
model CreativeAssetRevision {
  id String @id @default(cuid())
  organizationId String
  assetId String
  version Int
  sourceKind String
  sourceRef String
  renditionDigest String
  rightsExpiresAt DateTime
  rightsReviewedBy String?
  rightsReviewedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  asset CreativeAsset @relation(fields:[organizationId,assetId],references:[organizationId,id],onDelete:Restrict)
  approvals Approval[]
  publications CampaignPublication[]
  mediaEvidence VerifiedMediaEvidence[]
  @@unique([organizationId,id])
  @@unique([assetId,version])
  @@index([organizationId,assetId,version])
}

/**
 * R2 one authoritative publication-intent aggregate. Internal staging only:
 * no external provider account, access token or publishing authority.
 * Campaign/approval/DAM/Outbox remain their existing independent owners.
 */
/** R2H synthetic audience only; never store a live email address or imply consent. */
model MarketingSyntheticContact {
  id String @id @default(cuid())
  organizationId String
  brandId String
  syntheticRecipientRef String
  createdBy String
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,map:"MarketingSyntheticContact_org_fk")
  brand Brand @relation(fields:[organizationId,brandId],references:[organizationId,id],onDelete:Restrict,map:"MarketingSyntheticContact_org_brand_fk")
  consentEvents MarketingSyntheticConsent[]
  @@unique([organizationId,id])
  @@unique([organizationId,brandId,syntheticRecipientRef],map:"SyntheticContact_tenant_brand_ref_uq")
  @@index([organizationId,brandId,createdAt])
}

/** Append-only synthetic consent state events. NO legally verified opt-in. */
model MarketingSyntheticConsent {
  id String @id @default(cuid())
  organizationId String
  contactId String
  action String
  sequence Int
  evidenceRef String
  recordedBy String
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,map:"MarketingSyntheticConsent_org_fk")
  contact MarketingSyntheticContact @relation(fields:[organizationId,contactId],references:[organizationId,id],onDelete:Restrict,map:"MarketingSyntheticConsent_org_contact_fk")
  @@unique([organizationId,id])
  @@unique([organizationId,contactId,evidenceRef],map:"SyntheticConsent_tenant_contact_ref_uq")
  @@unique([organizationId,contactId,sequence])
  @@index([organizationId,contactId,createdAt],map:"SyntheticConsent_org_contact_time_idx")
}

/** Customer-visible status is SIMULATED/BLOCKED, never SENT or DELIVERED. */
model MarketingEmailSimulation {
  id String @id @default(cuid())
  organizationId String
  brandId String
  campaignId String
  audienceDigest String
  contentDigest String
  requestKey String
  status String @default("SIMULATED")
  result Json
  createdBy String
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,map:"MarketingEmailSimulation_org_fk")
  brand Brand @relation(fields:[organizationId,brandId],references:[organizationId,id],onDelete:Restrict,map:"MarketingEmailSimulation_org_brand_fk")
  campaign Campaign @relation(fields:[organizationId,campaignId],references:[organizationId,id],onDelete:Restrict,map:"MarketingEmailSimulation_org_campaign_fk")
  @@unique([organizationId,id])
  @@unique([organizationId,requestKey])
  @@index([organizationId,campaignId,createdAt],map:"EmailSim_org_campaign_time_idx")
}

model CampaignPublication {
  id String @id @default(cuid())
  organizationId String
  campaignId String
  creativeAssetRevisionId String
  approvalId String
  scopeDigest String
  requestKey String
  status String @default("PREPARED")
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  campaign Campaign @relation(fields:[organizationId,campaignId],references:[organizationId,id],onDelete:Restrict)
  creativeAssetRevision CreativeAssetRevision @relation(fields:[organizationId,creativeAssetRevisionId],references:[organizationId,id],onDelete:Restrict)
  approval Approval @relation(fields:[organizationId,approvalId],references:[organizationId,id],onDelete:Restrict)
  attempts PublicationAttempt[]
  @@unique([organizationId,id])
  @@unique([organizationId,requestKey])
  @@unique([organizationId,approvalId])
  @@index([organizationId,campaignId,status])
}
model PublicationAttempt {
  id String @id @default(cuid())
  organizationId String
  publicationId String
  sequence Int
  mode String @default("SANDBOX")
  outcome String
  evidenceRef String
  inputDigest String
  recordedBy String
  // R2F-D: PRE-AUTHORIZATION ONLY; never a remote send or delivery receipt.
  integrationConnectionId String?
  providerKey String?
  reservationExpiresAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  publication CampaignPublication @relation(fields:[organizationId,publicationId],references:[organizationId,id],onDelete:Restrict)
  connection IntegrationConnection? @relation(fields:[organizationId,integrationConnectionId],references:[organizationId,id],onDelete:Restrict,map:"PublicationAttempt_org_conn_fk")
  @@unique([organizationId,publicationId,sequence])
  @@index([organizationId,publicationId,createdAt])
  @@index([organizationId,integrationConnectionId,createdAt],map:"PublicationAttempt_org_conn_time_idx")
}

/** R2B provider-neutral destination registration, NOT credential storage.
 * No user-controlled field may mark an account as provider-verified.
 */
model IntegrationConnection {
  id String @id @default(cuid())
  organizationId String
  brandId String
  providerKey String
  destinationLabel String
  destinationRef String
  status String @default("PENDING_VERIFICATION")
  version Int @default(1)
  createdBy String
  suspendedAt DateTime?
  suspendedBy String?
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
