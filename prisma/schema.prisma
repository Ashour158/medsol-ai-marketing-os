generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum CampaignStatus { IDEA ASSESSMENT PROPOSED APPROVAL_PENDING APPROVED PLANNING IN_PRODUCTION REVIEW READY LIVE OPTIMIZING COMPLETED ANALYZED LEARNED ARCHIVED }
enum ApprovalDecision { PENDING APPROVED REJECTED APPROVED_WITH_CONDITIONS }
enum RiskLevel { R0 R1 R2 R3 R4 }
enum AgentStatus { ACTIVE PAUSED RETIRED }
enum AuditActorType { HUMAN AGENT SYSTEM }
model Organization { id String @id @default(cuid()); name String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; users User[]; agents Agent[]; objectives MarketingObjective[]; products MarketingProduct[]; campaigns Campaign[]; approvals Approval[]; auditEvents AuditEvent[]; commandReceipts CommandReceipt[]; outboxEvents OutboxEvent[] }
model User { id String @id @default(cuid()); organizationId String; email String; name String; role String; createdAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@unique([organizationId,email]); @@index([organizationId]) }
model Agent { id String @id; organizationId String; name String; status AgentStatus @default(ACTIVE); version Int @default(1); capabilities Json; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); executions AgentExecution[]; @@index([organizationId,status]) }
model AgentExecution { id String @id @default(cuid()); organizationId String; agentId String; correlationId String; causationId String?; input Json; decision Json?; status String; startedAt DateTime @default(now()); completedAt DateTime?; agent Agent @relation(fields:[agentId],references:[id],onDelete:Restrict); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@index([organizationId,correlationId]) }
model MarketingObjective { id String @id @default(cuid()); organizationId String; name String; description String; metric Json?; status String @default("ACTIVE"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); campaigns Campaign[]; @@index([organizationId,status]) }
model MarketingProduct { id String @id @default(cuid()); organizationId String; code String; name String; vendor String?; lifecycle String @default("ACTIVE"); marketingProfile Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); campaigns Campaign[]; @@unique([organizationId,code]) }
model Campaign { id String @id @default(cuid()); organizationId String; code String; name String; objectiveId String; productId String?; status CampaignStatus @default(IDEA); riskLevel RiskLevel @default(R1); version Int @default(1); metadata Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); objective MarketingObjective @relation(fields:[objectiveId],references:[id],onDelete:Restrict); product MarketingProduct? @relation(fields:[productId],references:[id],onDelete:Restrict); @@unique([organizationId,code]); @@index([organizationId,status]) }
model Approval { id String @id @default(cuid()); organizationId String; objectType String; objectId String; requiredAuthority String; riskLevel RiskLevel; decision ApprovalDecision @default(PENDING); decidedBy String?; rationale String?; createdAt DateTime @default(now()); decidedAt DateTime?; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@index([organizationId,objectType,objectId]); @@index([organizationId,decision]) }
model AuditEvent { id String @id @default(cuid()); organizationId String; actorType AuditActorType; actorId String; action String; objectType String; objectId String; before Json?; after Json?; correlationId String; causationId String?; occurredAt DateTime @default(now()); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@index([organizationId,occurredAt]); @@index([organizationId,objectType,objectId]) }
model CommandReceipt { id String @id @default(cuid()); organizationId String; commandId String; commandType String; correlationId String; status String; response Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@unique([organizationId,commandId]) }
model OutboxEvent { id String @id @default(cuid()); organizationId String; eventId String; eventType String; aggregateType String; aggregateId String; version Int @default(1); payload Json; correlationId String; causationId String?; occurredAt DateTime @default(now()); publishedAt DateTime?; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict); @@unique([organizationId,eventId]); @@index([organizationId,publishedAt,occurredAt]) }