# T1E NONSECRET staging operator environment EXAMPLE.
# Do not commit populated values, secrets or actual account credentials.
NODE_ENV=production
MARKETING_DEPLOYMENT_ENV=staging
MARKETING_IDENTITY_PROVIDER=STAGING_OIDC
MARKETING_STAGING_OIDC_ENABLED=OFFLINE_OPERATOR_TEST_ONLY
MARKETING_AUTH_MODE=oidc
MARKETING_TENANT_RESOLUTION_MODE=SIGNED_OIDC_CLAIM
MARKETING_BOOTSTRAP_ORGANIZATION_ID=
MARKETING_BOOTSTRAP_TOKEN=
MARKETING_EXTERNAL_EFFECTS_ENABLED=false
MARKETING_AI_REASONING_ENABLED=false
MARKETING_REAL_EMAIL_ENABLED=false
MARKETING_REAL_PROVIDER_PUBLISHING_ENABLED=false
MARKETING_LIVE_DELIVERY_ENABLED=false
MARKETING_PROVIDER_EGRESS_ENABLED=false
MARKETING_LIVE_CAMPAIGN_EXECUTION_ENABLED=false
MARKETING_OIDC_ISSUER=https://id.staging.medsol.example/realms/medsol
MARKETING_STAGING_OIDC_TRUSTED_ISSUER=https://id.staging.medsol.example/realms/medsol
MARKETING_OIDC_JWKS_URL=https://id.staging.medsol.example/realms/medsol/protocol/openid-connect/certs
MARKETING_OIDC_AUDIENCE=medsol-staging-api
MARKETING_OIDC_CLIENT_ID=medsol-staging-web
MARKETING_PUBLIC_ORIGIN=https://marketing.staging.medsol.example
MARKETING_API_INTERNAL_URL=http://api:3001

# SECRET-MANAGED VALUES; NEVER place them in this tracked file:
# MARKETING_STAGING_OIDC_CLIENT_SECRET  (>=32 random characters)
# MARKETING_SESSION_SECRET or MARKETING_SESSION_SECRETS  (base64url random 32 bytes)
# DATABASE_URL (API only, non-BYPASSRLS PostgreSQL staging runtime role)
# MARKETING_STAGING_API_IMAGE and MARKETING_STAGING_WEB_IMAGE
#   (approved registry/release artifact with pinned @sha256 digest)
